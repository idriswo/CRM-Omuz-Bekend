DATABASE_URL="postgresql://user:password@localhost:5432/omuz_crm?schema=public"
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
ACCESS_TOKEN_TTL="3h"
REFRESH_TOKEN_TTL="7d"
# Логини аввалин director. EMAIL логини вуруд аст, phone ихтиёрӣ.
SEED_DIRECTOR_EMAIL="director@example.com"
SEED_DIRECTOR_PASSWORD="Director@2026!"
PORT=4000

# --- Gmail SMTP (фиристодани email) ---
# GMAIL_APP_PASSWORD — "App Password"-и 16-аломата аз Google, НА пароли оддии ҳисоб.
# Гирифтан: Google Account → Security → 2-Step Verification (бояд фаъол бошад) → App passwords
#
# Агар GMAIL_USER ё GMAIL_APP_PASSWORD холӣ бошад, барнома дар режими stub кор мекунад:
# паёмҳо танҳо ба лог мераванд. Барои dev/тест ҳамин лозим аст.
#
# ⚠️ Gmail ~500 email дар рӯз иҷозат медиҳад. Барои фиристодани оммавӣ ин кам аст —
# дар оянда ба SendGrid/Resend/Mailgun гузаштан лозим (танҳо createTransport дар
# src/utils/mailer.ts иваз мешавад).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
MAIL_FROM_NAME="Omuz CRM"

