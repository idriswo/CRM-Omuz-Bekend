DATABASE_URL="postgresql://user:password@localhost:5432/omuz_crm?schema=public"
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
ACCESS_TOKEN_TTL="3h"
REFRESH_TOKEN_TTL="7d"
# Логини аввалин director. EMAIL логини вуруд аст, phone ихтиёрӣ.
SEED_DIRECTOR_EMAIL="director@example.com"
SEED_DIRECTOR_PASSWORD="Director@2026!"
PORT=4000

# --- Gmail API (роҳи асосии фиристодани email) ---
# Ҳамон почтаи Gmail, вале аз болои HTTPS (порти 443) — маҳз барои ҳамин дар
# Render кор мекунад, дар ҳоле ки Gmail SMTP не (Render портҳои 25/465/587-ро мебандад).
# Домен лозим нест, пардохт нест, тасдиқи рақами телефон нест.
#
# CLIENT_ID ва CLIENT_SECRET: Google Cloud Console → APIs & Services →
#   Credentials → Create credentials → OAuth client ID → Desktop app.
#   Пеш аз он дар "Enabled APIs & services" Gmail API-ро фаъол кунед.
#
# REFRESH_TOKEN: як бор бо ин фармон гирифта мешавад —
#   npx ts-node scripts/gmail-oauth.ts
#   Токен бемуҳлат аст, боз лозим намешавад.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
MAIL_FROM_EMAIL="your-address@gmail.com"
MAIL_FROM_NAME="Omuz CRM"

# --- Gmail SMTP (танҳо барои dev дар компютери худӣ) ---
# Агар GOOGLE_REFRESH_TOKEN гузошта шуда бошад, инҳо сарфи назар мешаванд.
# GMAIL_APP_PASSWORD — "App Password"-и 16-аломата аз Google, НА пароли оддии ҳисоб.
# Гирифтан: Google Account → Security → 2-Step Verification (бояд фаъол бошад) → App passwords
#
# ⚠️ Дар Render кор НАМЕКУНАД — портҳои SMTP баста мебошанд. Танҳо локалӣ.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Агар ҳеҷ яке аз инҳо гузошта нашуда бошад, барнома дар режими stub кор мекунад:
# паёмҳо танҳо ба лог мераванд. GET /health нишон медиҳад, ки кадомаш фаъол аст.

# --- Google Sheets (ихтиёрӣ, барои синхронизатсияи журнал) ---
# GOOGLE_SERVICE_ACCOUNT_JSON=''
