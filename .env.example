DATABASE_URL="postgresql://user:password@localhost:5432/omuz_crm?schema=public"
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
ACCESS_TOKEN_TTL="3h"
REFRESH_TOKEN_TTL="7d"
# Логини аввалин director. EMAIL логини вуруд аст, phone ихтиёрӣ.
SEED_DIRECTOR_EMAIL="director@example.com"
SEED_DIRECTOR_PASSWORD="Director@2026!"
PORT=4000

# --- Brevo (провайдери асосии email) ---
# Калид: brevo.com → SMTP & API → API Keys → Generate. Бо "xkeysib-" сар мешавад.
# Плани ройгон: 300 email дар рӯз, домени худӣ ЛОЗИМ НЕСТ.
#
# Brevo тавассути HTTPS (порти 443) мефиристад — маҳз барои ҳамин дар Render
# кор мекунад, дар ҳоле ки Gmail SMTP не (Render портҳои 25/465/587-ро мебандад).
#
# MAIL_FROM_EMAIL бояд дар Brevo ҳамчун sender тасдиқ шуда бошад:
# Senders, Domains & Dedicated IPs → Senders → Add a sender → пайванди тасдиқ
# ба ҳамон почта меояд. Суроғаи оддии Gmail мешавад.
BREVO_API_KEY=""
MAIL_FROM_EMAIL="your-address@gmail.com"

# --- Gmail SMTP (танҳо барои dev дар компютери худӣ) ---
# Агар BREVO_API_KEY гузошта шуда бошад, инҳо сарфи назар мешаванд.
# GMAIL_APP_PASSWORD — "App Password"-и 16-аломата аз Google, НА пароли оддии ҳисоб.
# Гирифтан: Google Account → Security → 2-Step Verification (бояд фаъол бошад) → App passwords
#
# ⚠️ Дар Render кор НАМЕКУНАД — портҳои SMTP баста мебошанд. Танҳо локалӣ.
# ⚠️ Gmail ~500 email дар рӯз иҷозат медиҳад.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
MAIL_FROM_NAME="Omuz CRM"

# Агар ҳеҷ яке аз инҳо гузошта нашуда бошад, барнома дар режими stub кор мекунад:
# паёмҳо танҳо ба лог мераванд. GET /health нишон медиҳад, ки кадомаш фаъол аст.

# --- Google Sheets (ихтиёрӣ, барои синхронизатсияи журнал) ---
# GOOGLE_SERVICE_ACCOUNT_JSON=''
